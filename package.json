{
  "name": "x-media-download-extension",
  "version": "0.1.1",
  "description": "Xのポストに含まれる画像・動画をワンクリックで保存するChrome拡張機能",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "npm run build && node scripts/test-browser.mjs",
    "check": "biome check src",
    "check:fix": "biome check --write --unsafe src",
    "typecheck": "tsc --noEmit",
    "build": "npm run check && npm run typecheck && vite build",
    "build:dev": "vite build --mode development",
    "watch": "vite build --mode development --watch",
    "pack": "npm run build && exr pack dist/",
    "release": "npm run build && exr release dist/ --force"
  },
  "keywords": ["chrome-extension", "x", "media", "download"],
  "repository": {
    "type": "git",
    "url": "https://github.com/yhotta240/x-media-download-extension.git"
  },
  "bugs": {
    "url": "https://github.com/yhotta240/x-media-download-extension/issues"
  },
  "homepage": "https://github.com/yhotta240/x-media-download-extension#readme",
  "author": "yhotta240",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@types/chrome": "^0.1.6",
    "@types/node": "^24.3.1",
    "@types/sanitize-html": "^2.16.0",
    "@types/ws": "^8.18.1",
    "@yhotamos/extension-release-cli": "^0.5.0",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.3",
    "sanitize-html": "^2.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vite-plugin-static-copy": "^4.1.1",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "fflate": "0.8.3"
  }
}
