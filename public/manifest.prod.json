{
  "manifest_version": 3,
  "name": "X Media Download",
  "short_name": "X Media Download",
  "version": "0.0.1",
  "description": "Xのポストに含まれる画像・動画をワンクリックで保存するChrome拡張機能",
  "icons": {
    "128": "icons/icon.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"]
    }
  ]
}
