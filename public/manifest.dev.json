{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "X Media Download",
  "short_name": "X Media Download",
  "version": "0.0.1",
  "description": "Xのポストに含まれる画像・動画をワンクリックで保存するChrome拡張機能",
  "icons": {
    "128": "icons/icon.png"
  },
  "permissions": ["storage", "downloads", "tabs", "offscreen"],
  "host_permissions": ["https://pbs.twimg.com/*", "https://video.twimg.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
